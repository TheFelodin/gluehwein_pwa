<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Glühwein</title>
<link rel="manifest" href="manifest.json">
<link rel="apple-touch-icon" href="apple-touch-icon.png">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="Glühwein">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="theme-color" content="#7a1c2c">
<style>
:root{--bg:#fff8f6;--card:#fff;--tx:#2a1a1c;--mut:#7a6568;--pr:#8e2434;--onpr:#fff;--chip:#f3dcd9;--line:#e6d3d0;--gold:#e8a317;--cup:#d9c9c6;--flake:#7f9cc4}
@media(prefers-color-scheme:dark){:root{--bg:#1a1112;--card:#2a1c1e;--tx:#f5e8e6;--mut:#b8a3a6;--pr:#ff9aa8;--onpr:#4a0f1a;--chip:#4a2a2f;--line:#4a3639;--cup:#5a4649;--flake:#fff}}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;background:var(--bg);color:var(--tx);font:16px/1.4 -apple-system,system-ui,"Segoe UI",Roboto,sans-serif}
body{padding:env(safe-area-inset-top) 0 0;min-height:100vh}
canvas#schnee{position:fixed;inset:0;width:100%;height:100%;pointer-events:none;z-index:0}
canvas#lichter{position:fixed;top:env(safe-area-inset-top);left:0;width:100%;height:30px;pointer-events:none;z-index:3}
main,#form{position:relative;z-index:1;max-width:640px;margin:0 auto}
header{display:flex;align-items:center;padding:16px 8px 8px 20px}
header div{flex:1}
h1{margin:0;font-size:28px;color:var(--pr)}
.sub{color:var(--mut);font-size:14px}.cd{color:var(--pr);font-size:14px;font-weight:600}
button{font:inherit;color:inherit;cursor:pointer}
.ib{background:none;border:0;font-size:24px;padding:10px;color:var(--tx)}
.btn{background:var(--pr);color:var(--onpr);border:0;border-radius:20px;padding:10px 20px;font-weight:600}
.btn.t{background:none;color:var(--pr)}.btn:disabled{opacity:.4}
#liste{padding:8px 16px 110px;display:grid;gap:12px}
.karte{display:flex;gap:12px;background:var(--card);border-radius:14px;padding:14px 12px 10px;box-shadow:0 1px 4px rgba(0,0,0,.18);position:relative;cursor:pointer}
.bild{width:88px;height:88px;border-radius:12px;background:var(--chip);flex:none;display:grid;place-items:center;font-size:32px;overflow:hidden}
.bild img{width:100%;height:100%;object-fit:cover}
.inh{flex:1;min-width:0}
.name{font-weight:600;font-size:17px;padding-right:22px;overflow-wrap:anywhere}
.kom{color:var(--mut);margin-top:4px;display:-webkit-box;-webkit-line-clamp:3;line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
.chips{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px}
.chip{background:var(--chip);border-radius:20px;padding:3px 10px;font-size:13px}
.stern{position:absolute;top:8px;right:10px}
.tassen{display:inline-flex;touch-action:pan-y;user-select:none;-webkit-user-select:none;padding:6px 0}
.t{position:relative;display:inline-block}
.t svg{display:block;width:100%;height:100%}
.t .f{position:absolute;left:0;top:0;height:100%;overflow:hidden}
.t .f svg{height:100%}
.base{color:var(--cup)}.fill{color:var(--gold)}
.fab{position:fixed;right:20px;bottom:calc(20px + env(safe-area-inset-bottom));z-index:4;box-shadow:0 3px 10px rgba(0,0,0,.35);padding:14px 22px;font-size:17px}
.leer{text-align:center;padding:60px 32px;color:var(--mut)}.leer b{display:block;font-size:20px;color:var(--tx);margin:8px 0}
#form{display:none;padding:0 16px calc(24px + env(safe-area-inset-bottom))}
#form h2{display:flex;align-items:center;margin:8px 0;font-size:22px}
label{display:block;font-size:13px;color:var(--mut);margin:14px 0 4px}
input[type=text],input[type=number],textarea{width:100%;font:inherit;color:var(--tx);background:var(--card);border:1px solid var(--line);border-radius:10px;padding:12px}
textarea{min-height:90px}
.reihe{display:flex;gap:8px;overflow-x:auto;padding:8px 0}
.reihe button{white-space:nowrap;background:var(--card);border:1px solid var(--line);border-radius:8px;padding:6px 12px}
.reihe button.an{background:var(--chip);border-color:var(--pr)}
.aktionen{display:flex;justify-content:flex-end;gap:8px;margin-top:20px;flex-wrap:wrap}
#vorschau{width:120px;height:120px;border-radius:12px;object-fit:cover;display:none;margin-top:10px}
#gross{position:fixed;inset:0;background:#000;z-index:10;display:none;align-items:center;justify-content:center}
#gross img{max-width:100%;max-height:100%}
dialog{border:0;border-radius:16px;background:var(--card);color:var(--tx);padding:20px;max-width:90vw;width:340px}
dialog::backdrop{background:rgba(0,0,0,.5)}
dialog h3{margin:0 0 8px}dialog select{font:inherit;width:100%;padding:10px;border-radius:10px;background:var(--bg);color:var(--tx);border:1px solid var(--line)}
.zeile{display:flex;align-items:center;gap:12px;margin:14px 0}.zeile span{flex:1}
#toast{position:fixed;left:50%;bottom:90px;transform:translateX(-50%);background:#333;color:#fff;padding:10px 16px;border-radius:20px;z-index:20;display:none;font-size:14px}
dialog{max-height:85vh;overflow:auto}dialog hr{border:0;border-top:1px solid var(--line);margin:14px 0}
body::before{content:"";position:fixed;top:0;left:0;right:0;height:env(safe-area-inset-top);background:#7a1c2c;z-index:5}
.hinweis{display:flex;align-items:center;gap:8px;margin:4px 16px;padding:8px 8px 8px 14px;background:var(--chip);border-radius:12px;font-size:14px;position:relative;z-index:1}
.hinweis[hidden]{display:none}.hinweis span{flex:1}.hinweis .ib{font-size:18px;padding:6px}
#advent{display:none;position:relative;z-index:1;max-width:640px;margin:0 auto;padding:0 16px calc(24px + env(safe-area-inset-bottom))}
#advent h2{display:flex;align-items:center;margin:8px 0;font-size:22px}
#tgrid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:14px}
.tf{position:relative;aspect-ratio:1;border:0;padding:0;border-radius:12px;overflow:hidden;background:var(--chip)}
.tf .hint{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;font-size:12px;font-weight:600;background:var(--chip)}
.tf .hint i{font-style:normal;width:36px;height:36px;border-radius:50%;display:grid;place-items:center;font-size:20px;background:color-mix(in srgb,var(--ak) 25%,transparent)}
.tf .tuer{position:absolute;inset:0;display:grid;place-items:center;background:var(--fa);color:#fff;font-size:24px;font-weight:700;transform-origin:left center;transform:perspective(300px) rotateY(0);transition:transform .5s;backface-visibility:hidden;-webkit-backface-visibility:hidden}
.tf.auf .tuer{transform:perspective(300px) rotateY(-105deg)}.tf.zu .tuer{opacity:.5}
body.deko main header{padding-top:36px}
.karte.haube::before{content:"";position:absolute;left:16px;right:16px;top:0;height:14px;pointer-events:none;filter:drop-shadow(0 1.5px 0 rgba(32,64,96,.14));
background:linear-gradient(#f4f8fc,#f4f8fc) 0 0/100% 4px no-repeat,
radial-gradient(circle 5px at 11px 4px,#f4f8fc 98%,#0000) 0 0/88px 14px repeat-x,
radial-gradient(circle 8px at 33px 4px,#f4f8fc 98%,#0000) 0 0/88px 14px repeat-x,
radial-gradient(circle 7px at 55px 4px,#f4f8fc 98%,#0000) 0 0/88px 14px repeat-x,
radial-gradient(circle 6px at 77px 4px,#f4f8fc 98%,#0000) 0 0/88px 14px repeat-x}
#rudolph{position:fixed;left:0;top:0;z-index:6;display:none;padding:8px;cursor:pointer;will-change:transform}
#rTier{position:relative;display:inline-block;font-size:44px;line-height:1}
#rNase{position:absolute;left:50%;top:50%;width:26px;height:26px;border-radius:50%;opacity:0;background:radial-gradient(circle,#ff1744,rgba(255,23,68,.4) 60%,transparent 70%)}
.rf{position:absolute;left:50%;top:50%;margin:-10px;font-size:18px;line-height:1;opacity:0}
#rBlase{position:absolute;left:50%;bottom:100%;width:max-content;max-width:180px;margin-bottom:-4px;padding:6px 10px;border-radius:12px;background:var(--chip);color:var(--tx);font-size:14px;font-weight:600;line-height:1.3;box-shadow:0 1px 4px rgba(0,0,0,.25);display:none;text-align:left}
#schlitten{position:fixed;top:calc(180px + env(safe-area-inset-top));left:0;z-index:7;font-size:44px;white-space:nowrap;pointer-events:none;display:none}
</style>
</head>
<body>
<canvas id="schnee"></canvas><canvas id="lichter"></canvas>

<main id="haupt">
  <header>
    <div><h1>Glühwein</h1><div class="sub" id="sub"></div><div class="cd" id="cd"></div><div class="cd" id="adHinweis" style="cursor:pointer"></div></div>
    <button class="ib" id="adventBtn" aria-label="Adventskalender" style="display:none">🎁</button><button class="ib" id="menuBtn" aria-label="Menü">⋮</button>
  </header>
  <div class="hinweis" id="iosHint" hidden><span>Tippe auf Teilen (□↑) und wähle „Zum Home-Bildschirm“. Starte die App dann von dort, nur so bleiben deine Bewertungen dauerhaft gespeichert. Die installierte App beginnt mit einer leeren Liste.</span><button class="ib" id="iosHintZu" aria-label="Schließen">✕</button></div>
  <section id="liste"></section>
  <button class="btn fab" id="neu">＋ Neu</button>
</main>

<section id="form">
  <h2><button class="ib" id="zurueck" aria-label="Zurück">←</button><span id="formTitel"></span></h2>
  <label for="barcode">Barcode</label>
  <div style="display:flex;gap:8px;align-items:center">
  <input type="text" id="barcode" inputmode="numeric" autocomplete="off" style="flex:1">
  <button class="btn t" id="scanBtn" type="button">Scannen</button>
  </div>
  <div class="sub" id="scanStatus"></div>
  <div class="sub" id="doppelt"></div>
  <label for="name">Name</label><input type="text" id="name" autocomplete="off">
  <label for="haendler">Gekauft bei</label><input type="text" id="haendler" autocomplete="off">
  <div class="reihe" id="vorschlaege"></div>
  <label for="preis">Preis in €</label><input type="text" id="preis" inputmode="decimal">
  <label>Foto</label>
  <img id="vorschau" alt="Vorschau">
  <div class="aktionen" style="justify-content:flex-start;margin-top:4px">
    <button class="btn t" id="fotoBtn">Foto aufnehmen / wählen</button>
    <button class="btn t" id="fotoWeg" style="display:none">Bild entfernen</button>
  </div>
  <input type="file" id="datei" accept="image/*" hidden>
  <label>Wertung</label>
  <div style="display:flex;align-items:center;gap:8px"><span id="wertungEin"></span><span id="wertungText" class="sub"></span></div>
  <div class="sub">Tippe auf die linke Hälfte einer Tasse für eine halbe Tasse.</div>
  <label for="kommentar">Kommentar</label><textarea id="kommentar"></textarea>
  <div class="aktionen">
    <button class="btn t" id="loeschen" style="display:none">Löschen</button>
    <button class="btn t" id="teilen">Teilen</button>
    <button class="btn t" id="abbrechen">Abbrechen</button>
    <button class="btn" id="speichern">Speichern</button>
  </div>
</section>

<dialog id="menu">
  <h3>Einstellungen</h3>
  <label for="sort">Sortieren nach</label>
  <select id="sort"><option value="neueste">Neueste</option><option value="beste">Beste</option><option value="name">Name</option></select>
  <div class="zeile"><span>Aufsteigend</span><input type="checkbox" id="asc"></div>
  <div class="zeile"><span>Weihnachtsdeko<br><small class="sub">15. November bis 6. Januar</small></span><input type="checkbox" id="deko"></div>
  <hr>
    <label for="mName">Dein Name</label><input type="text" id="mName" autocomplete="off">
    <div class="sub">Wird nur angezeigt, wenn du Bewertungen als Datei teilst.</div>
    <label>Deine Nutzer-ID</label>
    <div class="sub" id="mId" style="word-break:break-all"></div>
    <div class="aktionen" style="justify-content:flex-start"><button class="btn t" id="idKopieren">ID kopieren</button></div>
    <hr>
    <label>Teilen, Sichern und Importieren</label>
    <div class="aktionen" style="justify-content:flex-start">
    <button class="btn t" id="alleTeilen">Alle als Datei teilen</button>
    <button class="btn t" id="backup">Backup speichern</button>
    <button class="btn t" id="importBtn">Datei importieren</button>
    </div>
    <div class="sub" id="mMeldung"></div>
  <hr>
<p class="sub">Alle Daten bleiben auf diesem Gerät. Es gibt kein Konto und keinen Server. Die Nutzer-ID ist eine Zufallszahl ohne persönliche Angaben und wird nur in geteilten Dateien und Backups mitgeschickt. Beim Scannen wird die Barcode-Nummer an Open Food Facts gesendet, um Name, Bild und Händler zu holen. Dabei sieht Open Food Facts deine IP-Adresse. Wertung, Kommentar, Preis und Nutzer-ID werden nicht gesendet.</p>  <div class="aktionen"><button class="btn" id="menuZu">Fertig</button></div>
</dialog>
<dialog id="teilenDlg">
<h3>Teilen</h3>
<div class="sub" id="teilenTitel"></div>
<div class="aktionen" style="justify-content:stretch"><button class="btn" id="alsNachricht" style="flex:1">Als Nachricht (Text + Bild)</button></div>
<p class="sub">Text für alle Messenger, ohne die App.</p>
<hr>
<p class="sub">Für Freunde mit der App, die die Bewertung importieren können:</p>
<label for="tName">Dein Name</label><input type="text" id="tName" autocomplete="off">
<div class="sub" id="tMeldung"></div>
<div class="aktionen"><button class="btn t" id="tZu">Abbrechen</button><button class="btn" id="alsDatei">Als Datei senden</button></div>
</dialog>

<dialog id="importDlg">
<h3 id="impTitel"></h3>
<div id="impText"></div>
<div class="aktionen"><button class="btn t" id="impNein">Verwerfen</button><button class="btn" id="impJa">Übernehmen</button></div>
</dialog>

<input type="file" id="importDatei" accept=".json,application/json" hidden>
<dialog id="scanDlg">
<h3>Barcode scannen</h3>
<div id="leser" style="width:100%;min-height:200px"></div>
<div class="sub" id="scanMeldung"></div>
<div class="aktionen" style="justify-content:flex-start">
<button class="btn t" id="scanFoto" type="button">Foto statt Live-Bild</button>
<button class="btn t" id="scanLicht" type="button" style="display:none">Licht</button>
</div>
<div class="aktionen"><button class="btn t" id="scanZu">Abbrechen</button></div>
</dialog>
<input type="file" id="scanDatei" accept="image/*" capture="environment" hidden>
<section id="advent">
  <h2><button class="ib" id="adZurueck" aria-label="Zurück">←</button><span>Adventskalender</span></h2>
  <div class="sub" id="adZahl"></div>
  <div class="sub">🎯 Aufgabe · 📖 Fakt · 💡 Tipp · ✨ Idee · ✅ erledigt</div>
  <button class="btn t" id="adTest" style="display:none">Testtürchen zurücksetzen</button>
  <div id="tgrid"></div>
</section>
<dialog id="adventDlg">
  <h3 id="adT"></h3><div class="sub" id="adArt" style="font-weight:600"></div>
  <p id="adText"></p><div id="adStatus" style="font-weight:600"></div>
  <div class="aktionen"><button class="btn" id="adClose">Schließen</button></div>
</dialog>
<div id="rudolph"><div id="rBlase"></div><div id="rTier"><span>🦌</span><i id="rNase"></i><b class="rf">❄</b><b class="rf">❄</b><b class="rf">❄</b><b class="rf">❄</b><b class="rf">❄</b><b class="rf">❄</b><b class="rf">❄</b><b class="rf">❄</b></div></div>
<div id="schlitten">🎅🛷✨</div>
<div id="gross"><img alt=""></div>
<div id="toast"></div>

<script src="html5-qrcode.min.js"></script>
<script>
'use strict';
const $=s=>document.querySelector(s);
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const zahl=w=>String(w).replace('.',',');
const preisText=p=>p.toLocaleString('de-DE',{minimumFractionDigits:2,maximumFractionDigits:2})+' €';
const HAENDLER=['Aldi','Lidl','Edeka','Rewe','Netto','Kaufland','Penny'];
const store=(k,d)=>{try{const v=localStorage.getItem(k);return v===null?d:JSON.parse(v)}catch{return d}};
const speichere=(k,v)=>{try{localStorage.setItem(k,JSON.stringify(v))}catch{}};
function toast(t){const e=$('#toast');e.textContent=t;e.style.display='block';clearTimeout(toast.h);toast.h=setTimeout(()=>e.style.display='none',2500)}

/* ---------- Datenbank (IndexedDB) ---------- */
let db;
const dbOeffnen=()=>new Promise((ok,fehler)=>{
  const r=indexedDB.open('gluehwein',1);
  r.onupgradeneeded=()=>r.result.createObjectStore('weine',{keyPath:'id',autoIncrement:true});
  r.onsuccess=()=>{db=r.result;ok()};r.onerror=()=>fehler(r.error);
});
const dbOp=(modus,fn)=>new Promise((ok,fehler)=>{
  const t=db.transaction('weine',modus),r=fn(t.objectStore('weine'));
  t.oncomplete=()=>ok(r.result);t.onerror=()=>fehler(t.error);
});
const alle=()=>dbOp('readonly',s=>s.getAll());
const sichern=w=>dbOp('readwrite',s=>s.put(w));
const loesche=id=>dbOp('readwrite',s=>s.delete(id));

/* ---------- Tassen ---------- */
const TASSE='<svg viewBox="0 0 24 24" fill="currentColor"><path d="M4 8h13v7a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5V8z"/><path d="M17 10h1.5a2.5 2.5 0 0 1 0 5H17" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M8 3.5v2.5M11 3v3M14 3.5v2.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>';
const anteil=(w,n)=>{const r=Math.min(1,Math.max(0,w-(n-1)));return r>=.75?1:r>=.25?.5:0};
const wertungBei=(x,b)=>Math.min(10,Math.max(1,Math.floor(x/b*10)+1))/2;
function tassenHtml(w,px){
  let h='';
  for(let i=1;i<=5;i++)h+=`<span class="t" style="width:${px}px;height:${px}px"><span class="base">${TASSE}</span><span class="f fill" style="width:${anteil(w,i)*100}%"><span style="display:block;width:${px}px;height:${px}px">${TASSE}</span></span></span>`;
  return h;
}
function tassen(wert,px,onChange){
  const el=document.createElement('span');el.className='tassen';
  let w=wert,vor=null,runter=false;
  const zeige=v=>el.innerHTML=tassenHtml(v,px);
  zeige(w);
  if(onChange){
    const pos=e=>wertungBei(e.clientX-el.getBoundingClientRect().left,el.getBoundingClientRect().width);
    el.addEventListener('click',e=>e.stopPropagation());
    el.addEventListener('pointerdown',e=>{runter=true;el.setPointerCapture(e.pointerId);vor=pos(e);zeige(vor);e.stopPropagation()});
    el.addEventListener('pointermove',e=>{if(runter){vor=pos(e);zeige(vor)}});
    el.addEventListener('pointerup',e=>{if(!runter)return;runter=false;w=vor;zeige(w);onChange(w)});
    el.addEventListener('pointercancel',()=>{runter=false;zeige(w)});
  }
  return el;
}

/* ---------- Zustand und Liste ---------- */
let weine=[],aktuell=null,wertung=3,bild=null;
let sort=store('sort','neueste'),asc=store('asc',false),dekoAn=store('deko',true);
const weihnachtszeit=()=>{const d=new Date(),m=d.getMonth()+1,t=d.getDate();return(m===11&&t>=15)||m===12||(m===1&&t<=6)};
const deko=()=>dekoAn&&weihnachtszeit();

function sortiert(){
  const l=[...weine];
  if(sort==='neueste')l.sort((a,b)=>a.id-b.id);
  else if(sort==='beste')l.sort((a,b)=>a.wertung-b.wertung||a.id-b.id);
  else l.sort((a,b)=>a.name.toLowerCase().localeCompare(b.name.toLowerCase(),'de')||a.id-b.id);
  return asc?l:l.reverse();
}
function kopf(){
  const n=weine.length;
  $('#sub').textContent=n?`${n===1?'1 Bewertung':n+' Bewertungen'} · Ø ${(weine.reduce((s,w)=>s+w.wertung,0)/n).toFixed(1).replace('.',',')} von 5`:'Noch nichts bewertet';
  const h=new Date(),a=new Date(h.getFullYear(),11,24),tage=Math.round((a-new Date(h.getFullYear(),h.getMonth(),h.getDate()))/864e5);
  $('#cd').textContent=!deko()?'':tage>1?`🎄 Noch ${tage} Tage bis Heiligabend`:tage===1?'🎄 Morgen ist Heiligabend':tage===0?'🎄 Heute ist Heiligabend':h.getMonth()===11&&h.getDate()<=26?'🎄 Frohe Weihnachten':'';
}
function liste(){
  kopf();adventKopf();
  const L=$('#liste');L.innerHTML='';
  if(!weine.length){L.innerHTML='<div class="leer"><div style="font-size:64px">🍷</div><b>Noch keine Bewertungen</b>Tippe auf „Neu“ und bewerte deinen ersten Glühwein.</div>';return}
  for(const w of sortiert().filter(w=>verstecktAb==null||w.id<=verstecktAb)){
  const k=document.createElement('div');k.className='karte'+(deko()?' haube':'');
  const laden=[w.haendler,w.preis!=null?preisText(w.preis):null].filter(Boolean).join(' · ');
  const et=[laden?'🛒 '+laden:null,w.von?'von '+w.von:null].filter(Boolean);
  k.innerHTML=`<div class="bild">${w.bild?`<img src="${w.bild}" alt="">`:'🍷'}</div><div class="inh"><div class="name">${esc(w.name)}</div><div class="tp"></div>${w.kommentar?`<div class="kom">${esc(w.kommentar)}</div>`:''}${et.length?`<div class="chips">${et.map(c=>`<span class="chip">${esc(c)}</span>`).join('')}</div>`:''}</div>${w.wertung>=5?`<span class="stern">${deko()?'🎄':'⭐'}</span>`:''}`;
  k.querySelector('.tp').append(tassen(w.wertung,30,w.von?null:async v=>{const war=w.wertung;w.wertung=v;w.geaendert=Date.now();await sichern(w);liste();if(v>=5&&war<5)rentierJubel()}));
  if(w.bild)k.querySelector('.bild').addEventListener('click',e=>{e.stopPropagation();gross(w.bild)});
  k.addEventListener('click',()=>formOeffnen(w));
  L.append(k);
  }
}
function gross(src){const g=$('#gross');g.querySelector('img').src=src;g.style.display='flex';g.onclick=()=>g.style.display='none'}

/* ---------- Formular ---------- */
function ansicht(form){$('#haupt').style.display=form?'none':'';$('#form').style.display=form?'block':'none';window.scrollTo(0,0)}
function zeigeWertung(){
  const e=$('#wertungEin');e.innerHTML='';
  const t=tassen(wertung,46,v=>{wertung=v;zeigeWertung()});e.append(t);
  $('#wertungText').textContent=`${zahl(wertung)} von 5`;
}
function zeigeBild(){
  const v=$('#vorschau');v.style.display=bild?'block':'none';if(bild)v.src=bild;
  $('#fotoWeg').style.display=bild?'':'none';
}
function chips(){
  const h=$('#haendler').value.trim().toLowerCase(),R=$('#vorschlaege');R.innerHTML='';
  for(const n of HAENDLER){const b=document.createElement('button');b.textContent=n;if(h===n.toLowerCase())b.className='an';
    b.onclick=()=>{$('#haendler').value=h===n.toLowerCase()?'':n;chips()};R.append(b)}
}
function formOeffnen(w){
aktuell=w||null;wertung=w?w.wertung:3;bild=w?.bild||null;
$('#formTitel').textContent=w?'Glühwein bearbeiten':'Neuer Glühwein';
$('#barcode').value=w?.barcode||'';$('#scanStatus').textContent='';
$('#name').value=w?.name||'';$('#haendler').value=w?.haendler||'';
$('#preis').value=w?.preis!=null?String(w.preis.toFixed(2)).replace('.',','):'';
$('#kommentar').value=w?.kommentar||'';
$('#loeschen').style.display=w?'':'none';$('#teilen').style.display=w?'':'none';
zeigeWertung();zeigeBild();chips();pruefeName();barcodePruefen();ansicht(true);
}
const pruefeName=()=>$('#speichern').disabled=!$('#name').value.trim();
$('#name').oninput=pruefeName;$('#haendler').oninput=chips;
$('#preis').oninput=e=>e.target.value=e.target.value.replace(/[^0-9.,]/g,'').slice(0,8);
$('#neu').onclick=()=>formOeffnen(null);
$('#zurueck').onclick=$('#abbrechen').onclick=()=>ansicht(false);
$('#fotoBtn').onclick=()=>$('#datei').click();
$('#fotoWeg').onclick=()=>{bild=null;zeigeBild()};
$('#datei').onchange=async e=>{
  const f=e.target.files[0];e.target.value='';if(!f)return;
  try{
    const bmp=await createImageBitmap(f),s=Math.min(1,900/Math.max(bmp.width,bmp.height));
    const c=document.createElement('canvas');c.width=Math.round(bmp.width*s);c.height=Math.round(bmp.height*s);
    c.getContext('2d').drawImage(bmp,0,0,c.width,c.height);
    bild=c.toDataURL('image/jpeg',.82);zeigeBild();
  }catch{toast('Das Bild konnte nicht gelesen werden.')}
};
$('#speichern').onclick=async()=>{
const p=parseFloat($('#preis').value.replace(',','.'));
const w={...(aktuell||{}),name:$('#name').value.trim(),wertung,kommentar:$('#kommentar').value.trim(),
haendler:$('#haendler').value.trim()||null,preis:isNaN(p)||p<0?null:p,bild,
barcode:$('#barcode').value.replace(/\D/g,'').slice(0,14)||null,
eintragId:aktuell?.eintragId||crypto.randomUUID(),geaendert:Date.now()};
const jub=w.wertung>=5&&(aktuell?.wertung||0)<5,neuEintrag=!aktuell&&deko();if(neuEintrag){verstecktAb=weine.reduce((m,x)=>Math.max(m,x.id),0);sort='neueste';asc=false}await sichern(w);weine=await alle();ansicht(false);liste();if(neuEintrag)schlittenFlug();if(jub)rentierJubel();
};
$('#loeschen').onclick=async()=>{
  if(!confirm(`„${aktuell.name}“ wird endgültig gelöscht.`))return;
  await loesche(aktuell.id);weine=await alle();ansicht(false);liste();
};

/* ---------- Teilen ---------- */
async function teilen(w){
  try{
  const d={text:nachrichtText(w)};
  if(w.bild){
  try{
  const b=await (await fetch(w.bild)).blob(),f=new File([b],'gluehwein.jpg',{type:'image/jpeg'});
  if(navigator.canShare?.({files:[f]}))d.files=[f];
  }catch{}
  }
  if(navigator.share)await navigator.share(d);
  else{await navigator.clipboard.writeText(d.text);toast('Text in die Zwischenablage kopiert.')}
}catch(e){if(e.name!=='AbortError')toast('Teilen ist fehlgeschlagen.')}
}

/* ---------- Einstellungen ---------- */
$('#menuBtn').onclick=()=>{$('#sort').value=sort;$('#asc').checked=asc;$('#deko').checked=dekoAn;$('#menu').showModal()};
$('#menuZu').onclick=()=>{
  sort=$('#sort').value;asc=$('#asc').checked;dekoAn=$('#deko').checked;
  speichere('sort',sort);speichere('asc',asc);speichere('deko',dekoAn);
  $('#menu').close();liste();dekoUmschalten();
};

/* ---------- Schneefall und Lichterkette ---------- */
const sc=$('#schnee'),lc=$('#lichter'),dpr=window.devicePixelRatio||1;
let flocken=[],laeuft=false,W=0,H=0;
const rnd=(a,b)=>a+Math.random()*(b-a),ri=(a,b)=>Math.floor(rnd(a,b));
function flocke(r0,r1,t0,t1,a0,a1){return{x:Math.random(),v:Math.random(),tempo:ri(t0,t1),sw:ri(1,4),ph:Math.random(),r:rnd(r0,r1),a:rnd(a0,a1),dr:ri(-2,3)}}
function kristall(c,x,y,r,deg,farbe,alpha){
  c.save();c.translate(x,y);c.rotate(deg*Math.PI/180);
  c.strokeStyle=farbe;c.globalAlpha=alpha;c.lineWidth=Math.max(1,r*.16);c.lineCap='round';c.beginPath();
  for(let k=0;k<6;k++){
    const w=k*Math.PI/3,dx=Math.cos(w),dy=Math.sin(w);
    c.moveTo(0,0);c.lineTo(dx*r,dy*r);
    const ax=dx*r*.6,ay=dy*r*.6;
    for(const s of[-1,1]){const w2=w+s*Math.PI/4;c.moveTo(ax,ay);c.lineTo(ax+Math.cos(w2)*r*.35,ay+Math.sin(w2)*r*.35)}
  }
  c.stroke();c.restore();
}
function groesse(){
  W=innerWidth;H=innerHeight;
  for(const [c,h] of[[sc,H],[lc,30]]){c.width=W*dpr;c.height=h*dpr}
}
function zeichneLichter(zeit){
  const c=lc.getContext('2d');c.setTransform(dpr,0,0,dpr,0,0);c.clearRect(0,0,W,30);
  const n=12,ab=W/n,farben=['#E53935','#FFB300','#43A047','#1E88E5'];
  c.strokeStyle='rgba(120,120,120,.6)';c.lineWidth=1.5;c.beginPath();c.moveTo(0,2);
  for(let i=0;i<n;i++)c.quadraticCurveTo(i*ab+ab/2,18,(i+1)*ab,2);
  c.stroke();
  for(let i=0;i<n;i++){
    const x=i*ab+ab/2,y=15,p=.5+.5*Math.sin((zeit*2+i/4)*2*Math.PI),g=.55+.45*p;
    c.fillStyle=farben[i%4];c.globalAlpha=g*.3;c.beginPath();c.arc(x,y,9,0,7);c.fill();
    c.globalAlpha=g;c.beginPath();c.arc(x,y,4.5,0,7);c.fill();
  }
  c.globalAlpha=1;
}
function schleife(ms){
  if(!laeuft)return;
  const t=(ms/30000)%1;
  zeichneSchnee(t,ms);
  if(!$('#haupt').style.display)zeichneLichter((ms/3000)%1);
  else lc.getContext('2d').clearRect(0,0,W,30);
  requestAnimationFrame(schleife);
}
function dekoUmschalten(){
  const an=deko();
  sc.style.display=lc.style.display=an?'block':'none';document.body.classList.toggle('deko',an);
  if(an&&!laeuft){
    flockenNeu();
    groesse();laeuft=true;requestAnimationFrame(schleife);
  }else if(!an)laeuft=false;
}
addEventListener('resize',()=>laeuft&&groesse());
document.addEventListener('visibilitychange',()=>{if(!document.hidden&&deko()&&!laeuft){laeuft=true;requestAnimationFrame(schleife)}else if(document.hidden)laeuft=false});
if(matchMedia('(prefers-reduced-motion: reduce)').matches)dekoAn=false;

/* ---------- Nutzer-ID, Export, Import und Backup (Format gluehwein-v3) ---------- */

const meineId=()=>{let id=store('nutzerId',null);if(!id){id=crypto.randomUUID();speichere('nutzerId',id)}return id};
const meinName=()=>String(store('name','')||'').trim();
const wertungText=w=>'☕'.repeat(Math.floor(w))+(w%1?'½':'');
const nachrichtText=w=>{
const laden=[w.haendler,w.preis!=null?preisText(w.preis):null].filter(Boolean).join(' · ');
return`🍷 ${w.name}\n${wertungText(w.wertung)}  (${zahl(w.wertung)} von 5)`+(laden?`\n🛒 ${laden}`:'')+(w.kommentar?`\n„${w.kommentar}“`:'');
};
const ranglisteText=()=>'🍷 Meine Glühwein-Rangliste\n'+[...weine]
.sort((a,b)=>b.wertung-a.wertung||a.name.toLowerCase().localeCompare(b.name.toLowerCase(),'de'))
.map(w=>`\n${zahl(w.wertung)}/5 ${wertungText(w.wertung)} ${w.name}${w.haendler?` (${w.haendler})`:''}`).join('');

/* --- Export --- */

const bildBase64=d=>{const m=/^data:image\/jpeg;base64,([A-Za-z0-9+/=]+)$/.exec(d||'');return m?m[1]:null};

async function verkleinern(d,maxSeite,q){
const bmp=await createImageBitmap(await (await fetch(d)).blob());
const s=Math.min(1,maxSeite/Math.max(bmp.width,bmp.height));
const c=document.createElement('canvas');c.width=Math.round(bmp.width*s);c.height=Math.round(bmp.height*s);
c.getContext('2d').drawImage(bmp,0,0,c.width,c.height);
return c.toDataURL('image/jpeg',q);
}

async function eintragJson(w,modus,absender){
const von=modus==='backup'?w.von:(w.von||absender),vonId=modus==='backup'?w.vonId:(w.vonId||meineId());
const o={id:w.eintragId,name:w.name,wertung:w.wertung,kommentar:w.kommentar||'',geaendert:w.geaendert||0};
if(von)o.von=von;if(vonId)o.vonId=vonId;
if(w.barcode)o.barcode=w.barcode;
if(w.haendler)o.haendler=w.haendler;
if(w.preis!=null)o.preis=w.preis;
if(w.bild){
if(/^https:/.test(w.bild))o.bildUrl=w.bild;
else{
let d=w.bild;
if(modus!=='backup'){try{d=await verkleinern(w.bild,modus==='einzeln'?800:400,modus==='einzeln'?.8:.7)}catch{}}
const b=bildBase64(d);if(b)o.bildBase64=b;
}
}
return o;
}

function herunterladen(blob,name){
const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=name;
document.body.append(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(a.href),10000);
toast('Datei gespeichert.');
}

async function dateiTeilen(daten,name,text){
const blob=new Blob([JSON.stringify(daten)],{type:'application/json'});
const f=new File([blob],name,{type:'application/json'});
try{
if(navigator.canShare?.({files:[f]})){
const d={files:[f]};if(text)d.text=text;
await navigator.share(d);return;
}
}catch(e){if(e.name==='AbortError')return}
herunterladen(blob,name);
}

async function einzelnAlsDatei(w,absender){
const o=await eintragJson(w,'einzeln',absender);
const kurzname=w.name.replace(/[^A-Za-z0-9]/g,'').slice(0,30)||'Bewertung';
await dateiTeilen({format:'gluehwein-v3',bewertungen:[o]},`Gluehwein-${kurzname}.json`,nachrichtText(w));
}

async function alleAlsDatei(absender){
toast('Bereite Datei vor …');
const l=[];for(const w of sortiert())l.push(await eintragJson(w,'liste',absender));
await dateiTeilen({format:'gluehwein-v3',bewertungen:l},'Gluehwein-Bewertungen.json',ranglisteText());
}

async function backupSpeichern(){
toast('Bereite Backup vor …');
const l=[];for(const w of weine)l.push(await eintragJson(w,'backup',''));
const daten={format:'gluehwein-v3',backup:{nutzerId:meineId(),name:meinName(),erstellt:new Date().toISOString()},bewertungen:l};
await dateiTeilen(daten,`gluehwein-backup-${new Date().toISOString().slice(0,10)}.json`,'');
}

/* --- Import --- */

const ID_OK=s=>typeof s==='string'&&/^[A-Za-z0-9-]{8,64}$/.test(s);
const kurz=(s,n)=>String(s??'').trim().slice(0,n);
const gutesBild=u=>{try{const x=new URL(u);return x.protocol==='https:'&&(x.hostname==='openfoodfacts.org'||x.hostname.endsWith('.openfoodfacts.org'))?x.href:null}catch{return null}};

async function eintragLesen(o){
const name=kurz(o.name,100);if(!name)return null;
let w=typeof o.wertung==='number'?o.wertung:typeof o.sterne==='number'?o.sterne:3;
if(!isFinite(w))w=3;
w=Math.min(5,Math.max(.5,Math.round(w*2)/2));
const e={
eintragId:ID_OK(o.id)?o.id:null,vonId:ID_OK(o.vonId)?o.vonId:null,von:kurz(o.von,40)||null,
name,wertung:w,kommentar:kurz(o.kommentar,1000),
barcode:String(o.barcode??'').replace(/\D/g,'').slice(0,14)||null,haendler:kurz(o.haendler,40)||null,
preis:typeof o.preis==='number'&&isFinite(o.preis)&&o.preis>=0&&o.preis<=10000?o.preis:null,
geaendert:Math.min(Date.now(),Math.max(0,Number(o.geaendert)||0)),bild:null
};
if(typeof o.bildBase64==='string'&&o.bildBase64.length<4000000&&/^[A-Za-z0-9+/=]+$/.test(o.bildBase64)){
const d='data:image/jpeg;base64,'+o.bildBase64;
try{await createImageBitmap(await (await fetch(d)).blob());e.bild=d}catch{}
}
if(!e.bild&&typeof o.bildUrl==='string')e.bild=gutesBild(o.bildUrl);
return e;
}

async function dateiLesen(text){
let j;try{j=JSON.parse(text)}catch{return null}
const f=j&&j.format,max=j&&j.backup?500:100;
const roh=f==='gluehwein-v1'?[j]:(f==='gluehwein-v2'||f==='gluehwein-v3')&&Array.isArray(j.bewertungen)?j.bewertungen.slice(0,max):null;
if(!roh)return null;
const l=[];for(const o of roh)if(o&&typeof o==='object'){const e=await eintragLesen(o);if(e)l.push(e)}
const b=j.backup&&typeof j.backup==='object'?{nutzerId:ID_OK(j.backup.nutzerId)?j.backup.nutzerId:null,name:kurz(j.backup.name,40),erstellt:kurz(j.backup.erstellt,30)}:null;
return{liste:l,backup:b};
}

function planen(l,vorhanden,backupModus){
const gesehen=new Set(),plaene=[];
for(const d of l){
const key=d.eintragId||`${d.name}|${d.von}|${d.barcode}`;
if(gesehen.has(key))continue;gesehen.add(key);
const t=d.eintragId?vorhanden.find(w=>w.eintragId===d.eintragId)
:vorhanden.find(w=>w.name.toLowerCase()===d.name.toLowerCase()&&(w.von||null)===(d.von||'Freund')&&(w.barcode||null)===d.barcode);
let art='neu';
if(t){
const neuer=d.geaendert>(t.geaendert||0);
art=backupModus?(neuer?'update':'bekannt'):(t.vonId&&t.vonId===d.vonId&&neuer?'update':'bekannt');
}
plaene.push({d,art,t});
}
return plaene;
}

async function anwenden(plaene,backupModus){
for(const {d,art,t} of plaene){
if(art==='bekannt')continue;
const basis={name:d.name,wertung:d.wertung,kommentar:d.kommentar,barcode:d.barcode,haendler:d.haendler,preis:d.preis,
bild:d.bild||(t?t.bild:null)||null,geaendert:d.geaendert||Date.now(),vonId:d.vonId,
von:backupModus?d.von:(d.von||(t?t.von:null)||'Freund')};
const w=art==='update'?{...t,...basis}:{...basis,eintragId:d.eintragId||crypto.randomUUID()};
await sichern(w);
}
}

let offenerImport=null;

function importZeigen({liste:l,backup}){
const plaene=planen(l,weine,!!backup);
const neu=plaene.filter(p=>p.art==='neu'),upd=plaene.filter(p=>p.art==='update'),an=neu.length+upd.length;
const schon=plaene.length-an;
let titel,text;
if(backup){
titel='Backup einspielen';
text=`Das Backup enthält ${l.length} Bewertungen${backup.erstellt?` (erstellt ${esc(backup.erstellt.slice(0,10))})`:''}: ${neu.length} neu, ${upd.length} aktualisiert, ${schon} schon vorhanden.`
+(backup.nutzerId&&backup.nutzerId!==meineId()?'<br><br>Deine Nutzer-ID wird auf die ID aus dem Backup gesetzt, damit deine geteilten Bewertungen derselben Person zugeordnet bleiben.':'');
}else if(!an){
titel='Bewertung erhalten';text='Das hast du schon in deiner Liste.';
}else if(an===1){
const p=(neu[0]||upd[0]).d;
titel='Bewertung erhalten';
text=`${esc(p.von||'Ein Freund')} hat „${esc(p.name)}“ ${upd.length?'aktualisiert':'bewertet'}:<br>${zahl(p.wertung)} von 5 ${wertungText(p.wertung)}`+(p.kommentar?`<br>„${esc(p.kommentar)}“`:'');
}else{
titel='Bewertungen erhalten';
text=`${esc(l[0].von||'Ein Freund')} hat dir ${an} Bewertungen geschickt (${neu.length} neu, ${upd.length} aktualisiert), zum Beispiel:<br>`
+[...neu,...upd].slice(0,3).map(p=>`${zahl(p.d.wertung)}/5 ${esc(p.d.name)}`).join('<br>')
+(schon?`<br><br>${schon} schon vorhanden, werden übersprungen.`:'');
}
$('#impTitel').textContent=titel;$('#impText').innerHTML=text;
$('#impJa').disabled=!an&&!backup;
offenerImport={plaene,backup};
$('#importDlg').showModal();
}

$('#impNein').onclick=()=>{offenerImport=null;$('#importDlg').close()};
$('#impJa').onclick=async()=>{
const o=offenerImport;offenerImport=null;$('#importDlg').close();if(!o)return;
await anwenden(o.plaene,!!o.backup);
if(o.backup){
if(o.backup.nutzerId)speichere('nutzerId',o.backup.nutzerId);
if(o.backup.name&&!meinName())speichere('name',o.backup.name);
}
weine=await alle();liste();toast('Importiert.');
};
$('#importDatei').onchange=async e=>{
const f=e.target.files[0];e.target.value='';if(!f)return;
if(f.size>30*1024*1024)return toast('Die Datei ist zu groß.');
let r=null;try{r=await dateiLesen(await f.text())}catch{}
if(!r||!r.liste.length)return toast('In der Datei wurden keine gültigen Bewertungen gefunden.');
importZeigen(r);
};

/* --- Bedienung: Menü und Teilen-Dialog --- */

const meldung=t=>$('#mMeldung').textContent=t;
$('#menuBtn').addEventListener('click',()=>{$('#mName').value=String(store('name','')||'');$('#mId').textContent=meineId();meldung('')});
$('#mName').oninput=e=>speichere('name',e.target.value);
$('#idKopieren').onclick=async()=>{try{await navigator.clipboard.writeText(meineId());meldung('ID kopiert.')}catch{meldung('Kopieren nicht möglich.')}};
$('#alleTeilen').onclick=()=>{
const n=meinName();if(!n)return meldung('Trage zuerst deinen Namen ein.');
if(!weine.length)return meldung('Noch keine Bewertungen.');
$('#menuZu').click();alleAlsDatei(n);
};
$('#backup').onclick=()=>{
if(!weine.length)return meldung('Noch keine Bewertungen.');
$('#menuZu').click();backupSpeichern();
};
$('#importBtn').onclick=()=>{$('#menuZu').click();$('#importDatei').click()};

let teilenZiel=null;
function teilenOeffnen(w){
teilenZiel=w;$('#teilenTitel').textContent='„'+w.name+'“';
$('#tName').value=String(store('name','')||'');$('#tMeldung').textContent='';
$('#teilenDlg').showModal();
}
$('#teilen').onclick=()=>teilenOeffnen(aktuell);
$('#tZu').onclick=()=>$('#teilenDlg').close();
$('#alsNachricht').onclick=()=>{const w=teilenZiel;$('#teilenDlg').close();teilen(w)};
$('#alsDatei').onclick=()=>{
const n=$('#tName').value.trim();
if(!n)return $('#tMeldung').textContent='Bitte gib deinen Namen ein.';
speichere('name',n);const w=teilenZiel;$('#teilenDlg').close();einzelnAlsDatei(w,n);
};
/* ---------- Barcode-Scanner und Open Food Facts ---------- */

let leser=null;

async function scannerStoppen(){
const l=leser;leser=null;
if(l){try{await l.stop()}catch{}try{l.clear()}catch{}}
if($('#scanDlg').open)$('#scanDlg').close();
}

const NATIV_NUTZEN=true; // auf false stellen = ZXing erzwingen (so verhält sich ein iPhone)
let licht=false;

async function scannerStarten(){
if(typeof Html5Qrcode==='undefined')return toast('Der Scanner konnte nicht geladen werden.');
$('#scanMeldung').textContent='Starte Kamera …';
$('#scanLicht').style.display='none';licht=false;
$('#scanDlg').showModal();
let gefunden=false;
try{
const F=Html5QrcodeSupportedFormats;
const nativ=NATIV_NUTZEN&&'BarcodeDetector' in window;
leser=new Html5Qrcode('leser',{
formatsToSupport:[F.EAN_13,F.EAN_8,F.UPC_A],
experimentalFeatures:{useBarCodeDetectorIfSupported:nativ},
verbose:false
});
await leser.start(
{facingMode:'environment'},
{
fps:15,
videoConstraints:{facingMode:{ideal:'environment'},width:{ideal:1920},height:{ideal:1080}},
qrbox:(b,h)=>({width:Math.max(60,Math.floor(b*.9)),height:Math.max(60,Math.floor(h*.5))})
},
code=>{
if(gefunden)return;gefunden=true;
scannerStoppen().then(()=>barcodeGefunden(code));
},
()=>{}
);
if(!leser)return;
let info=nativ?'Browser-Erkennung':'ZXing';
try{const s=leser.getRunningTrackSettings();if(s&&s.width)info+=`, Kamera ${s.width}×${s.height}`}catch{}
try{await leser.applyVideoConstraints({advanced:[{focusMode:'continuous'}]})}catch{}
try{const c=leser.getRunningTrackCapabilities();if(c&&c.torch)$('#scanLicht').style.display=''}catch{}
$('#scanMeldung').textContent=`Barcode quer, groß und ruhig in den Rahmen halten (etwa 15 bis 25 cm). ${info}`;
}catch{
leser=null;
$('#scanMeldung').textContent='Kamera nicht verfügbar. Prüfe die Berechtigung in den Browser- oder Systemeinstellungen oder tippe den Barcode ein.';
}
}

function barcodePruefen(){
const b=$('#barcode').value.replace(/\D/g,''),d=$('#doppelt');d.innerHTML='';
const t=b&&weine.find(w=>!w.von&&w.barcode===b&&w.id!==aktuell?.id);
if(t){
d.append('Schon bewertet: '+t.name+' ');
const k=document.createElement('button');k.className='btn t';k.type='button';
k.textContent='Vorhandene Bewertung öffnen';k.onclick=()=>formOeffnen(t);d.append(k);
}
}

async function offAbfrage(code){
const s=$('#scanStatus');s.textContent='Suche Produktdaten …';
try{
const r=await fetch(`https://world.openfoodfacts.org/api/v2/product/${code}.json?fields=product_name,brands,image_front_url,stores`);
if(!r.ok){s.textContent='Nichts gefunden. Bitte Namen selbst eintragen.';return}
const p=(await r.json()).product;
if(!p){s.textContent='Nichts gefunden. Bitte Namen selbst eintragen.';return}
const name=String(p.product_name||'').trim(),marke=String(p.brands||'').split(',')[0].trim();
const anzeige=name&&marke&&!name.toLowerCase().includes(marke.toLowerCase())?`${name} (${marke})`:(name||marke);
if(anzeige&&!$('#name').value.trim())$('#name').value=anzeige;
const laden=String(p.stores||'').split(',')[0].trim();
if(laden&&!$('#haendler').value.trim())$('#haendler').value=laden;
const u=gutesBild(p.image_front_url||'');
if(u&&!bild){bild=u;zeigeBild()}
pruefeName();chips();
s.textContent=anzeige||laden||u?'':'Nichts gefunden. Bitte Namen selbst eintragen.';
}catch{s.textContent='Keine Verbindung oder Abfrage blockiert. Bitte Namen selbst eintragen.'}
}

async function barcodeGefunden(code){
$('#barcode').value=code;barcodePruefen();await offAbfrage(code);
}

$('#scanBtn').onclick=scannerStarten;
$('#scanZu').onclick=scannerStoppen;
$('#scanDlg').addEventListener('close',()=>{if(leser)scannerStoppen()});
$('#barcode').oninput=e=>{e.target.value=e.target.value.replace(/\D/g,'').slice(0,14);barcodePruefen()};
$('#barcode').onchange=e=>{if(/^\d{8,14}$/.test(e.target.value))offAbfrage(e.target.value)};
$('#scanLicht').onclick=async()=>{
licht=!licht;
try{await leser.applyVideoConstraints({advanced:[{torch:licht}]})}catch{licht=!licht}
};

async function barcodeAusBild(datei){
if('BarcodeDetector' in window){
try{
const d=new BarcodeDetector({formats:['ean_13','ean_8','upc_a']});
const treffer=await d.detect(await createImageBitmap(datei));
if(treffer.length)return treffer[0].rawValue;
}catch{}
}
try{
const F=Html5QrcodeSupportedFormats;
const h=new Html5Qrcode('leser',{formatsToSupport:[F.EAN_13,F.EAN_8,F.UPC_A],verbose:false});
const text=await h.scanFile(datei,false);
try{h.clear()}catch{}
return text;
}catch{return null}
}

$('#scanFoto').onclick=async()=>{await scannerStoppen();$('#scanDatei').click()};
$('#scanDatei').onchange=async e=>{
const f=e.target.files[0];e.target.value='';if(!f)return;
const s=$('#scanStatus');s.textContent='Lese Barcode aus dem Foto …';
const code=await barcodeAusBild(f);
if(code&&/^\d{8,14}$/.test(code))barcodeGefunden(code);
else s.textContent='Im Foto wurde kein Barcode erkannt. Aus 10 bis 20 cm fotografieren, Code groß und scharf, oder die Nummer eintippen.';
};
/* ---------- Adventskalender ---------- */
const ADVENT_TESTTAG=0; // Zum Testen einen Tag von 1 bis 24 eintragen, vor dem Verteilen wieder 0
const adventsTag=()=>{if(ADVENT_TESTTAG>0)return Math.min(ADVENT_TESTTAG,24);const d=new Date(),m=d.getMonth()+1;return m===12?Math.min(d.getDate(),24):m===1&&d.getDate()<=6?24:0};
const adventJahr=()=>{const d=new Date();return d.getMonth()===0?d.getFullYear()-1:d.getFullYear()};
const adventKey=t=>ADVENT_TESTTAG>0?'test-'+t:adventJahr()+'-'+t;
const adventDatum=t=>ADVENT_TESTTAG>0?new Date():new Date(adventJahr(),11,t);
const adventOffen=()=>new Set(store('adventOffen',[]));
const istTag=(ms,d)=>{const x=new Date(ms);return x.getFullYear()===d.getFullYear()&&x.getMonth()===d.getMonth()&&x.getDate()===d.getDate()};
const eigene=()=>weine.filter(w=>!w.von);
const am=(d,f)=>eigene().some(w=>istTag(w.geaendert||0,d)&&f(w));
const SYM={Aufgabe:'🎯',Fakt:'📖',Tipp:'💡'},ARTF={Aufgabe:'#8E1B3A',Fakt:'#1E5FA8',Tipp:'#2E6B3F'};
const sym=a=>SYM[a]||'✨';
const ADV=[
['Aufgabe','Willkommen im Advent! Bewerte heute einen Glühwein.',d=>am(d,()=>true)],
['Fakt','Schon die Römer würzten Wein mit Honig und Gewürzen. Der Vorläufer des Glühweins ist also rund 2000 Jahre alt.'],
['Aufgabe','Füge heute bei einer Bewertung ein Foto hinzu.',d=>am(d,w=>!!w.bild)],
['Tipp','Glühwein sollte nicht kochen. Ideal sind etwa 60 bis 70 °C, sonst verfliegen Alkohol und Aroma.'],
['Aufgabe','Schreibe heute einen Kommentar zu einem Glühwein.',d=>am(d,w=>!!(w.kommentar||'').trim())],
['Fakt','In der EU ist Glühwein gesetzlich geregelt: Er besteht aus gewürztem Wein und hat zwischen 7 und 14,5 Prozent Alkohol.'],
['Aufgabe','Trage heute bei einer Bewertung den Preis ein. So findest du den Preis-Leistungs-Sieger.',d=>am(d,w=>w.preis!=null)],
['Tipp','Nimm Zimtstangen statt Zimtpulver, dann bleibt dein Glühwein klar.'],
['Idee','Probiere heute einen weißen Glühwein. Er schmeckt oft fruchtiger und heller.'],
['Aufgabe','Bewerte heute zwei Glühweine am selben Tag.',d=>eigene().filter(w=>istTag(w.geaendert||0,d)).length>=2],
['Fakt','Alkohol erweitert die Blutgefäße. Die Haut fühlt sich warm an, der Körper kühlt aber eher schneller aus.'],
['Aufgabe','Scanne heute einen Barcode und lass Name und Bild automatisch ausfüllen.',d=>am(d,w=>!!w.barcode)],
['Tipp','Orangenscheiben nur kurz mitziehen lassen. Die weiße Haut der Schale kann sonst bitter werden.'],
['Aufgabe','Hast du Glühwein von mindestens drei verschiedenen Händlern bewertet?',()=>new Set(eigene().map(w=>(w.haendler||'').trim().toLowerCase()).filter(Boolean)).size>=3],
['Fakt','Bei der Feuerzangenbowle tropft brennender, rumgetränkter Zuckerhut in den heißen Rotwein.'],
['Idee','Teile heute eine Bewertung mit einem Freund. Gemeinsam schmeckt Glühwein besser.'],
['Aufgabe','Vergib heute mindestens vier Tassen. Welcher Glühwein hat es verdient?',d=>am(d,w=>w.wertung>=4)],
['Fakt','Glühwein gibt es in vielen Ländern: In Schweden heißt er Glögg, in Frankreich vin chaud.'],
['Aufgabe','Bewerte heute einen Glühwein von einem Händler, bei dem du noch nichts bewertet hast.',d=>{const m=eigene();return m.some(w=>istTag(w.geaendert||0,d)&&(w.haendler||'').trim()&&!m.some(o=>o.id<w.id&&(o.haendler||'').toLowerCase()===w.haendler.toLowerCase()))}],
['Tipp','Zucker oder Honig erst am Ende dazugeben und abschmecken. So wird der Glühwein nicht zu süß.'],
['Aufgabe','Hast du heute einen Glühwein mit fünf Tassen gefunden?',d=>am(d,w=>w.wertung>=5)],
['Fakt','Auf vielen Weihnachtsmärkten ist die Glühweintasse ein Sammlerstück. Manche Städte bringen jedes Jahr ein neues Motiv heraus.'],
['Idee','Schau dir deine Rangliste an und wähle den „Glühwein des Jahres“.'],
['Idee','Frohe Weihnachten! Dein Adventskalender ist komplett. Trinke heute eine Tasse auf deinen Lieblingsglühwein. Prost!']
];
function adventKopf(){
  const t=adventsTag(),an=deko()&&t>0;
  $('#adventBtn').style.display=an?'':'none';
  const offen=an&&(ADVENT_TESTTAG>0||new Date().getMonth()===11)&&!adventOffen().has(adventKey(t));
  $('#adHinweis').textContent=offen?`🎁 Türchen ${t} wartet auf dich!`:'';
}
function adventRaster(){
  const heute=adventsTag(),offen=adventOffen(),G=$('#tgrid'),FA=['var(--pr)','#2E6B3F','#b07a1c'];let n=0;G.innerHTML='';
  for(let t=1;t<=24;t++){
    const o=offen.has(adventKey(t)),[art,,pr]=ADV[t-1];if(o)n++;
    const er=o&&pr?pr(adventDatum(t)):null,b=document.createElement('button');
    b.className='tf'+(o?' auf':'')+(t>heute?' zu':'');
    b.style.setProperty('--fa',FA[(t-1)%3]);b.style.setProperty('--ak',ARTF[art]||'#8A5A00');
    b.innerHTML=`<span class="hint">${o?`<i>${sym(art)}</i>${er===null?'':er?'✅':'offen'}`:'⭐'}</span><span class="tuer">${t}</span>`;
    b.onclick=()=>adventKlick(t,b);G.append(b);
  }
  $('#adZahl').textContent=`${n} von 24 Türchen geöffnet`;
}
function adventZeigen(t){
  const [art,text,pr]=ADV[t-1],er=pr?pr(adventDatum(t)):null;
  $('#adT').textContent='Türchen '+t;$('#adArt').textContent=`${sym(art)} ${art}`;$('#adText').textContent=text;
  $('#adStatus').textContent=er===null?'':er?'✅ Erledigt':'Noch nicht erledigt';
  $('#adventDlg').showModal();
}
function adventKlick(t,b){
  if(t>adventsTag())return toast(`Türchen ${t} ist erst am ${t}. Dezember dran.`);
  const k=adventKey(t),o=adventOffen();
  if(o.has(k))return adventZeigen(t);
  o.add(k);speichere('adventOffen',[...o]);b.classList.add('auf');
  setTimeout(()=>{adventZeigen(t);adventRaster();adventKopf()},550);
}
function adventAnsicht(an){
  $('#haupt').style.display=an?'none':'';$('#advent').style.display=an?'block':'none';
  if(an){$('#adTest').style.display=ADVENT_TESTTAG>0?'':'none';adventRaster()}
  window.scrollTo(0,0);
}
$('#adventBtn').onclick=$('#adHinweis').onclick=()=>adventAnsicht(true);
$('#adZurueck').onclick=()=>{adventAnsicht(false);liste()};
$('#adClose').onclick=()=>$('#adventDlg').close();
$('#adTest').onclick=()=>{speichere('adventOffen',[...adventOffen()].filter(k=>!k.startsWith('test-')));adventRaster();adventKopf()};
document.addEventListener('visibilitychange',()=>{if(!document.hidden){kopf();adventKopf()}});

/* ---------- Hinweis „Zum Home-Bildschirm“ (nur iOS im Browser) ---------- */
(()=>{
  const ios=/iphone|ipad|ipod/i.test(navigator.userAgent)||(navigator.platform==='MacIntel'&&navigator.maxTouchPoints>1);
  const app=navigator.standalone===true||matchMedia('(display-mode: standalone)').matches;
  if(ios&&!app&&!store('iosHinweisZu',false))$('#iosHint').hidden=false;
  $('#iosHintZu').onclick=()=>{$('#iosHint').hidden=true;speichere('iosHinweisZu',true)};
})();

/* ---------- Schneefall mit Finger, Rudolph, Schlitten ---------- */
let fern=[],finger=null,vorherDruck=null,letzteZeit=0,verstecktAb=null;
const gegriffen={i:-1};
function flockenNeu(){
  fern=Array.from({length:100},()=>flocke(3,6,1,3,.25,.55));
  flocken=Array.from({length:45},()=>({...flocke(7,13,2,5,.5,.9),ox:0,oy:0,vx:0,vy:0}));
}
const fingerPos=e=>{const p=(e.touches&&e.touches[0])||e;return{x:p.clientX,y:p.clientY}};
const opt={passive:true,capture:true};
addEventListener('touchstart',e=>{finger=fingerPos(e)},opt);
addEventListener('touchmove',e=>{finger=fingerPos(e)},opt);
addEventListener('touchend',e=>{finger=e.touches.length?fingerPos(e):null},opt);
addEventListener('touchcancel',()=>{finger=null},opt);
addEventListener('mousedown',e=>{finger=fingerPos(e)},opt);
addEventListener('mousemove',e=>{if(e.buttons)finger=fingerPos(e)},opt);
addEventListener('mouseup',()=>{finger=null},opt);
const basis=(f,t)=>({x:f.x*W+Math.sin((f.ph+f.sw*t)*2*Math.PI)*14,y:((f.v+f.tempo*t)%1)*H});
function physik(t,jetzt){
  const dt=Math.min(.05,Math.max(.001,(jetzt-letzteZeit)/1000));letzteZeit=jetzt;
  const d=finger;
  if(d&&!vorherDruck){
    let b=-1,ba=44;
    flocken.forEach((f,i)=>{const p=basis(f,t),a=Math.hypot(p.x+f.ox-d.x,p.y+f.oy-d.y);if(a<ba){ba=a;b=i}});
    gegriffen.i=b;
  }
  if(!d)gegriffen.i=-1;
  vorherDruck=d;
  const g=gegriffen.i,reich=g>=0?70:90,gr=3000;
  flocken.forEach((f,i)=>{
    const p=basis(f,t);
    if(i===g&&d){
      const nx=d.x-p.x,ny=d.y-p.y;
      f.vx=Math.max(-gr,Math.min(gr,(nx-f.ox)/dt));f.vy=Math.max(-gr,Math.min(gr,(ny-f.oy)/dt));
      f.ox=nx;f.oy=ny;return;
    }
    if(d){
      const dx=p.x+f.ox-d.x,dy=p.y+f.oy-d.y,a=Math.hypot(dx,dy);
      if(a<reich&&a>1){const s=1-a/reich;f.vx+=dx/a*s*1600*dt;f.vy+=dy/a*s*1600*dt}
    }
    f.ox+=f.vx*dt;f.oy+=f.vy*dt;
    const br=Math.max(0,1-3*dt);f.vx*=br;f.vy*=br;
    const zu=Math.max(0,1-.9*dt);f.ox*=zu;f.oy*=zu;
  });
}
function zeichneSchnee(t,jetzt){
  const c=sc.getContext('2d');c.setTransform(dpr,0,0,dpr,0,0);c.clearRect(0,0,W,H);
  const farbe=getComputedStyle(document.documentElement).getPropertyValue('--flake').trim();
  physik(t,jetzt||performance.now());
  for(const f of fern){const b=basis(f,t);kristall(c,b.x,b.y,f.r,f.ph*360+t*f.dr*360,farbe,f.a)}
  flocken.forEach((f,i)=>{
    const b=basis(f,t),g=i===gegriffen.i;
    kristall(c,b.x+f.ox,b.y+f.oy,f.r*(g?1.4:1),f.ph*360+t*f.dr*360,farbe,g?1:f.a);
  });
}

/* --- Schlitten bei neuem Eintrag: Karte erscheint, wenn er in der Mitte ist --- */
function schlittenFlug(){
  const e=$('#schlitten'),t0=performance.now();let mitte=false;e.style.display='block';
  const f=t=>{
    const p=Math.min(1,(t-t0)/2000);
    e.style.transform=`translate(${(innerWidth+140)-(innerWidth+280)*p}px,${Math.sin(p*4*Math.PI)*18}px)`;
    if(p>=.5&&!mitte){mitte=true;verstecktAb=null;liste()}
    if(p<1)requestAnimationFrame(f);else{e.style.display='none';verstecktAb=null;liste()}
  };
  requestAnimationFrame(f);
}

/* --- Rudolph --- */
const RENTIER_BLICKT_LINKS=true; // false, falls das Rentier rückwärts läuft
const NASE_X=-20,NASE_Y=-6;      // Lage der Nase zur Emoji-Mitte, auf dem iPhone ggf. anpassen
const SPRUECHE=['Ho ho ho! 🎅','Schon wieder ein Glühwein?','Meine Nase leuchtet nur für dich. 🔴','Frohe Weihnachten! 🎄','Hast du schon bewertet?','🎁 Bald ist Bescherung!'];
const rEl=$('#rudolph'),rTier=$('#rTier'),rNase=$('#rNase'),rBlase=$('#rBlase'),rFl=[...document.querySelectorAll('.rf')];
const R={gr:1,sp:0,wa:0,sn:0,na:0};
let rSicht=false,rRechts=true,rBahn=.7,rPos=0,rPause=false,rTipps=0,rErinnert=false,rSofort=false,rBis=performance.now()+rnd(8000,15000),rLetzt=0;
const schlaf=ms=>new Promise(r=>setTimeout(r,ms));
const tw=(k,z,ms)=>new Promise(ok=>{const a=R[k],t0=performance.now();const f=t=>{const p=Math.min(1,(t-t0)/ms);R[k]=a+(z-a)*p;if(p<1)requestAnimationFrame(f);else ok()};requestAnimationFrame(f)});
const rAktiv=()=>deko()&&!$('#haupt').style.display&&!document.querySelector('dialog[open]')&&$('#gross').style.display!=='flex';
const rMitte=()=>(innerWidth+120)*(rRechts?rPos:1-rPos)-120+35;
const imBild=rand=>{if(!rSicht)return false;const m=rMitte();return m>=rand&&m<=innerWidth-rand};
const adventHinweis=()=>$('#adHinweis').textContent||null;
const adventWissen=()=>{const o=adventOffen();return ADV.map((a,i)=>[a,i+1]).filter(([a,t])=>o.has(adventKey(t))&&a[0]!=='Aufgabe').map(([a])=>`${sym(a[0])} ${a[1]}`)};
rNase.style.marginLeft=(NASE_X-13)+'px';rNase.style.marginTop=(NASE_Y-13)+'px';
function rRender(){
  const W2=innerWidth,H2=innerHeight,an=rRechts?rPos:1-rPos;
  const x=(W2+120)*an-120,hup=rPause?0:Math.abs(Math.sin(rPos*60))*12,y=H2*rBahn-hup-R.sp*28;
  rEl.style.transform=`translate(${x}px,${y}px)`;
  const sp=(rRechts===RENTIER_BLICKT_LINKS)?-1:1;
  rTier.style.transform=`scale(${sp*R.gr},${R.gr}) rotate(${R.wa}deg)`;
  rNase.style.opacity=Math.min(1,Math.max(0,R.na));rNase.style.transform=`scale(${R.na})`;
  rFl.forEach((e,k)=>{const w=k*Math.PI/4,d=R.sn*90;e.style.opacity=R.sn>0?1-R.sn:0;e.style.transform=`translate(${Math.cos(w)*d}px,${Math.sin(w)*d-R.sn*20}px)`});
  const m=rMitte(),sh=Math.min(Math.max(m,95),W2-95)-m;
  rBlase.style.transform=`translateX(calc(-50% + ${sh}px))`;
}
async function reagiere(text){
  if(rPause)return;
  rPause=true;rTipps++;navigator.vibrate?.(30);
  const h=adventHinweis(),w=adventWissen();
  const t=text||(rTipps%5===0?'🍷 Prost, auf dich!':h&&rTipps%2===1?h:w.length&&Math.random()<.5?w[Math.floor(Math.random()*w.length)]:SPRUECHE[Math.floor(Math.random()*SPRUECHE.length)]);
  rBlase.textContent=t;rBlase.style.display='block';
  tw('gr',1.5,250);tw('na',1,300);
  (async()=>{R.sn=0;await tw('sn',1,1100);R.sn=0})();
  for(let i=0;i<2;i++){await tw('sp',1,170);await tw('sp',0,170)}
  await tw('wa',12,120);await tw('wa',-12,160);await tw('wa',0,120);
  await schlaf(Math.max(600,t.length*45));
  tw('na',0,250);await tw('gr',1,250);
  rBlase.style.display='none';rPause=false;
}
async function rentierJubel(){
  let v=0;
  while((rPause||!imBild(innerWidth*.3))&&v<200){if(!rSicht)rSofort=true;await schlaf(100);v++}
  if(!rPause&&imBild(innerWidth*.3))reagiere('Fünf Tassen! 🏆');
  rSofort=false;
}
function rTick(ms){
  requestAnimationFrame(rTick);
  if(document.hidden){rLetzt=0;return}
  const dt=rLetzt?Math.min(.1,(ms-rLetzt)/1000):0;rLetzt=ms;
  if(!rSicht){
    if(rSofort||ms>=rBis){
      if(!deko()){rBis=ms+5000;return}
      rRechts=Math.random()<.5;rBahn=.55+Math.random()*.3;rPos=0;rSicht=true;
    }else return;
  }
  if(!rPause)rPos+=dt/8;
  if(!rErinnert&&!rPause&&adventHinweis()&&rPos>=.4&&rPos<=.6&&imBild(innerWidth*.3)){rErinnert=true;reagiere(adventHinweis())}
  rEl.style.display=rAktiv()?'block':'none';
  rRender();
  if(rPos>=1){rSicht=false;rEl.style.display='none';rBis=ms+rnd(25000,60000)}
}
rEl.addEventListener('click',()=>{if(imBild(45))reagiere()});
requestAnimationFrame(rTick);

/* ---------- Geteilte Datei empfangen (Android Share-Target) ---------- */
async function geteiltesPruefen(){
  if(!/[?&]geteilt=1/.test(location.search))return;
  history.replaceState(null,'',location.pathname);
  try{
    const c=await caches.open('gluehwein-share'),r=await c.match('geteilt.json');
    if(!r)return toast('Es wurde keine Datei empfangen.');
    const text=await r.text();await c.delete('geteilt.json');
    const x=await dateiLesen(text);
    if(!x||!x.liste.length)return toast('In der Datei wurden keine gültigen Bewertungen gefunden.');
    importZeigen(x);
  }catch{toast('Die geteilte Datei konnte nicht gelesen werden.')}
}

/* ---------- Start ---------- */
(async()=>{
  try{
  await dbOeffnen();weine=await alle();
  for(const w of weine)if(!w.eintragId){w.eintragId=crypto.randomUUID();await sichern(w)}
  }
  catch{toast('Speicher nicht verfügbar. Bewertungen können nicht gespeichert werden.')}
  liste();dekoUmschalten();
  geteiltesPruefen();
  Promise.resolve(navigator.storage?.persist?.()).catch(()=>{});
  if('serviceWorker'in navigator)navigator.serviceWorker.register('sw.js').catch(()=>{});
})();
</script>
</body>
</html>
